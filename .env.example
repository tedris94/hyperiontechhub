# Hyperion Tech Hub — Environment Variables

# Required — copy full URI from Supabase Dashboard → Connect → Session pooler
# Use Session mode (port 5432) for local migrate/seed. Username MUST be postgres.<project-ref>.
# Host must match the dashboard exactly (aws-0-REGION or aws-1-REGION — do not guess).
DATABASE_URI=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
# If migrate fails with "tenant/user … not found":
#   - Project paused/deleted → restore or create a new project and replace DATABASE_URI
#   - Wrong pooler host → re-copy Session pooler URI from the dashboard (aws-0 vs aws-1)
# Direct connection (DDL). App can keep using DATABASE_URI pooler above.
# DATABASE_URI_MIGRATE=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
# Vercel runtime (transaction pooler, port 6543):
# DATABASE_URI=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true

PAYLOAD_SECRET=change-me-to-a-long-random-string-at-least-48-chars
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Storage (S3-compatible) — required on Vercel for media uploads
S3_ENDPOINT=https://[project-ref].supabase.co/storage/v1/s3
S3_BUCKET=media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1

# Optional — email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Hyperion Tech Hub <noreply@hyperiontechhub.com>"

# Seed script defaults
SEED_SUPER_ADMIN_EMAIL=superadmin@hyperiontechhub.com
SEED_SUPER_ADMIN_PASSWORD=demo1234

# Disable Payload (frontend-only fallback)
# DISABLE_PAYLOAD=1

# Bunny.net Stream — course video hosting
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_CDN_HOSTNAME=
BUNNY_TOKEN_AUTH_KEY=

# Paystack — course payments (amounts in kobo)
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# ICMS custom domains (Vercel Domains API)
# Create a token at https://vercel.com/account/tokens with access to this project.
# Project ID: Vercel → Project → Settings → General
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=team_xxx

